# Where the backend (@okkly/resume-be) lives.
#
# Dev: leave both unset — Vite proxies `/be/*` to http://localhost:5300 (see
#      vite.config.ts), so the app stays same-origin and CORS never applies.
#      Override the proxy target with VITE_API_TARGET if the backend is elsewhere.
# Prod: set VITE_API_BASE_URL to the backend's public origin. It must be listed in
#       the backend's CORS_ORIGINS.

# VITE_API_TARGET=http://localhost:5300
# VITE_API_BASE_URL=https://resume-api.example.com
