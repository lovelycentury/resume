# Caddy inside the resume-fe image — serves the built SPA on :80. The outer
# reverse proxy (vps-infra / okkly ops) terminates TLS and forwards here.
:80 {
	root * /srv
	encode zstd gzip

	try_files {path} /index.html
	file_server

	@hashed path_regexp \.[0-9a-f]{8,}\.(js|css|woff2|png|svg|jpg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	respond /healthz 200

	log {
		output stdout
		format console
	}
}
