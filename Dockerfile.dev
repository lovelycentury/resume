# syntax=docker/dockerfile:1.7
#
# Shared dev image for `docker-compose.dev.yml` — one image, run by three services
# (`be`, `fe`, `ingest`) with different commands.
#
# Build context is the MONOREPO ROOT. Dependencies are installed into the image
# (linux-native binaries for esbuild / rollup / libsql / sass) and the workspace
# libs the apps import are built. At runtime only `apps/resume/{be,fe}/src` (and a
# few configs) are bind-mounted over this copy, so edits there hot-reload while
# node_modules stay put. Add a dependency → `docker compose -f docker-compose.dev.yml up --build`.

FROM node:22-slim AS dev
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    CI="true"
RUN corepack enable
WORKDIR /repo

# `.dockerignore` already drops node_modules / .env / build output.
COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile


# be = 5300, fe = 5173. Vite HMR uses the same 5173.
EXPOSE 5300 5173
