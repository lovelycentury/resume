# Copy to `.env` and fill in. Only GOOGLE_GENERATIVE_AI_API_KEY is required.

# Required — powers the default chat model *and* the embeddings behind the vector store,
# so neither ingestion nor retrieval works without it.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — each one unlocks the models of that provider in /models.
# Models whose key is missing are returned with `available: false`.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama Cloud key — unlocks the hosted `gemma-4-31b` entry.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api

# libSQL. `file:` keeps everything on local disk (bare `pnpm dev` / `pnpm ingest`).
#  - docker compose: the compose file overrides these with http://libsql:8080.
#  - host-run ingest against the compose's libSQL: VECTOR_DB_URL=http://127.0.0.1:8080
#  - Turso: a libsql:// URL plus the matching *_AUTH_TOKEN below.
VECTOR_DB_URL=file:./.mastra/resume-vector.db
VECTOR_DB_AUTH_TOKEN=
STORAGE_DB_URL=file:./.mastra/resume-storage.db
STORAGE_DB_AUTH_TOKEN=

PORT=5300

# `/chat` requests allowed per IP per minute (public endpoint, shared provider quota).
CHAT_RATE_LIMIT=40
# Only `true` behind a reverse proxy that sets X-Forwarded-For. Otherwise the header is
# caller-supplied and would let anyone bypass the limit.
TRUST_PROXY=false
DEFAULT_MODEL_ID=minimax-m3

# Comma-separated. Must include the origin the `fe` app is served from.
CORS_ORIGINS=http://localhost:5173
